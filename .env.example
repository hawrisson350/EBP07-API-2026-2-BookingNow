# Plantilla local. Copia a .env y completa tus propios datos; nunca la uses como .env directamente.
spring.profiles.active=cloud
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200
DB_URL=jdbc:postgresql://localhost:5432/bookingnow
DB_USERNAME=postgres
DB_PASSWORD=
JAVA_TOOL_OPTIONS=-Xms64m -Xmx256m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError

# Genera una clave propia para desarrollo; no reutilices una clave publicada.
JWT_SECRET=

# Correo transaccional Resend. Usa una clave de envío y un remitente permitido.
RESEND_API_KEY=
RESEND_FROM=
RESEND_BASE_URL=https://api.resend.com
