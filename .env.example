# Plantilla local. Copia a .env y completa tus propios datos; nunca la uses como .env directamente.
spring.profiles.active=cloud
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200
DB_URL=jdbc:postgresql://localhost:5432/bookingnow
DB_USERNAME=postgres
DB_PASSWORD=
JAVA_TOOL_OPTIONS=-Xms64m -Xmx256m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError

# Genera una clave propia para desarrollo; no reutilices una clave publicada.
JWT_SECRET=

# Elige resend (actual) o gmail. Gmail usa una contraseña de aplicación, nunca la contraseña normal.
BOOKINGNOW_EMAIL_PROVIDER=resend
# Gmail SMTP: smtp.gmail.com, puerto 587 con STARTTLS.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_FROM=

# Opcional en EC2: montar index.html fuera del JAR para actualizar solo el panel.
# BOOKINGNOW_DASHBOARD_FILE=/app/dashboard/index.html

# Alternativa Resend:
RESEND_API_KEY=
RESEND_FROM=
RESEND_BASE_URL=https://api.resend.com
