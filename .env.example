# Plantilla para Docker Compose. No contiene credenciales reales.
# Spring Boot no carga .env automaticamente; en Render usa Environment.
SPRING_PROFILES_ACTIVE=cloud
DB_URL=jdbc:postgresql://HOST-DEL-SESSION-POOLER:5432/postgres?sslmode=require
DB_USERNAME=postgres.REFERENCIA-DEL-PROYECTO
DB_PASSWORD=REEMPLAZAR
JAVA_TOOL_OPTIONS=-Xms64m -Xmx256m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError
